    "satori": "^0.25.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource/geist-mono": "^5.2.8",
