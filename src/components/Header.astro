---
import { navItems } from '../data/nav';

const normalizePath = (path: string) => path.endsWith('/') && path !== '/' ? path.slice(0, -1) : path;
const currentPath = normalizePath(Astro.url.pathname);

const isActive = (href: string) => {
  const normalizedHref = normalizePath(href);
  return currentPath === normalizedHref || currentPath.startsWith(normalizedHref + '/');
};
---

<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <a href="/" class="site-header__wordmark">adrian lumley</a>
    <nav class="site-header__nav" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === normalizePath(item.href) ? 'page' : undefined}
          class:list={['site-header__nav-link', isActive(item.href) && 'is-active']}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }

  .site-header__bar {
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--s5) clamp(var(--s4), 5vw, var(--s7));
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
  }

  /* the wordmark is the record's own type: the same sans, size, and weight
     as the lede on the homepage, and the one link without an underline. */
  .site-header__wordmark {
    flex: 0 0 auto;
    padding: .75rem 0;
    margin: -.75rem 0;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__nav {
    display: flex;
    gap: var(--s4);
    white-space: nowrap;
  }

  /* 44px tap target, paid back with a matching negative margin */
  .site-header__nav-link {
    display: inline-block;
    padding: .75rem .3rem;
    margin: -.75rem -.3rem;
  }

  /* the section you are in carries the heavier current-page rule */
  .site-header__nav-link.is-active {
    text-decoration-thickness: var(--link-rule-current);
  }

  @media (min-width: 768px) {
    .site-header__nav { gap: var(--s5); }
  }
</style>
