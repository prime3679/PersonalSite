---
interface Props {
  entries: { time: string; text: string }[];
}

const { entries } = Astro.props;
---

<ul class="signal-log">
  {entries.map((entry) => (
    <li><span class="signal-time">{entry.time}</span><span>{entry.text}</span></li>
  ))}
</ul>

<style>
  .signal-log {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--panel-text);
    font-family: var(--mono);
    font-size: .8125rem;
    line-height: 1.9;
  }
  .signal-log li {
    display: grid;
    grid-template-columns: 3.375rem 1fr;
    gap: .875rem;
  }
  .signal-time {
    color: var(--panel-soft);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 600px) {
    .signal-log li {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: .7rem;
    }
  }
</style>
