---
import '../styles/global.css';
// the record is set in one sans, so that file is preloaded everywhere.
// essays opt into the serif preload with the `serif` prop; geist mono
// stays lazy for code blocks and the signal room instrument.
import geistWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import newsreaderWoff2 from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { siteMetadata } from '../data/siteMetadata';
import { navItems } from '../data/nav';
import { CSP_POLICY } from '../data/csp';
import { absoluteUrl, canonicalUrl } from '../lib/seo';
import Header from '../components/Header.astro';
import DelightLayer from '../components/DelightLayer.astro';

interface ArticleData {
  headline: string;
  description: string;
  datePublished: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: ArticleData;
  mainClass?: string;
  extraMainClass?: string;
  /** site chrome: header, footer, and the night shift toggle that ships
   *  with the header. the homepage turns it off so the record is the whole
   *  page rather than content inside an app shell. */
  chrome?: boolean;
  /** preload the serif reading face; only the essay route sets this */
  serif?: boolean;
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  ogImage: ogImageOverride = '/og/home.png',
  article,
  mainClass = 'site-main',
  extraMainClass,
  chrome = true,
  serif = false,
} = Astro.props;
const fullTitle = title === siteMetadata.title ? title : `${title} | ${siteMetadata.siteName}`;
const canonicalPageUrl = canonicalUrl(Astro.url);
const ogImageUrl = absoluteUrl(ogImageOverride);

const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteMetadata.url}/#person`,
      name: siteMetadata.author,
      url: siteMetadata.url,
      image: absoluteUrl(siteMetadata.image),
      jobTitle: siteMetadata.jobTitle,
      sameAs: siteMetadata.social,
      description: siteMetadata.personDescription,
      alumniOf: siteMetadata.alumniOf.map((name) => ({
        '@type': 'CollegeOrUniversity',
        name,
      })),
      knowsAbout: siteMetadata.knowsAbout,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteMetadata.url}/#website`,
      url: siteMetadata.url,
      name: siteMetadata.siteName,
      publisher: { '@id': `${siteMetadata.url}/#person` },
    },
    ...(article ? [{
      '@type': 'Article',
      headline: article.headline,
      datePublished: article.datePublished,
      description: article.description,
      author: { '@id': `${siteMetadata.url}/#person` },
      publisher: { '@id': `${siteMetadata.url}/#person` },
      url: canonicalUrl(article.url),
    }] : []),
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="theme-color" content="#f7f3ea" />
  <script is:inline>
    // night shift: runs before the stylesheet so there is no light flash.
    // paper and ink remap together in tokens.css, so the shift never puts
    // light ink on light ground; the theme-color meta follows the paper.
    (() => {
      let dark = false;
      try {
        const stored = localStorage.getItem('theme');
        dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      } catch {}
      if (dark) {
        document.documentElement.classList.add('dark');
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', '#16130e');
      }
    })();
  </script>
  <meta http-equiv="Content-Security-Policy" content={CSP_POLICY} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalPageUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="canonical" href={canonicalPageUrl} />
  <link rel="alternate" type="application/rss+xml" title={`${siteMetadata.siteName} · writing`} href="/rss.xml" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href={geistWoff2} />
  {serif && <link rel="preload" as="font" type="font/woff2" crossorigin href={newsreaderWoff2} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="author" content={siteMetadata.author} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="aa267d21-11bc-40c3-a359-974f47e24791"></script>
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-[var(--paper)] focus:px-4 focus:py-2">skip to content</a>
  {chrome && <Header />}
  <main id="main" tabindex="-1" class:list={[mainClass, extraMainClass, 'focus:outline-hidden']}>
    <slot />
  </main>
  {chrome && (
    <footer class="border-t border-[var(--line)] py-8">
      <div class="site-footer-inner mx-auto flex max-w-[52rem] flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
        <span>adrian lumley · nyc</span>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-2" aria-label="footer">
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a href="/about/">about</a>
          <a href="/rss.xml">rss</a>
        </nav>
      </div>
    </footer>
  )}
  <DelightLayer />
</body>
</html>
