---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { currentRole, pastEmployers, pastRoles } from '../data/career';

const goodreads = 'https://www.goodreads.com/user/show/149439647-adrian-lumley';

const work = [currentRole, ...pastRoles];
---

<Base title="About" description={`about adrian lumley: product leader, fourteen years in, director of product at salesforce on emerging technology. previously ${pastEmployers.toLowerCase()}.`}>
  <PageIntro title="about" standfirst="product leader, builder, and new yorker working on enterprise ai adoption." />

  <div class="content-stack">
    <p>i'm a product leader, fourteen years in, currently director of product management at salesforce on the emerging technology team. my work is enterprise ai adoption: the gap between what a model can do and what a large organization will actually absorb. that gap is where the hard, interesting problems live.</p>
    <p>what's different now is that i build, not just spec. i've run my own agents, eval harnesses, and model routing, and kept what held up: a public evidence ledger for enterprise ai and a few small tools, all in the <a href="/lab/">lab</a>. some of it ships. some of it doesn't survive contact with reality. i write about both.</p>
  </div>

  <section id="work" class="mt-12 scroll-mt-8" aria-labelledby="work-h">
    <h2 id="work-h" class="label">work</h2>
    <dl class="rows rows--loose mt-2">
      {work.map((role) => (
        <div class="row" id={role.id}>
          <dt class="row__key">{role.company}</dt>
          <dd class="row__value">{role.summary ?? ''}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mt-12" aria-labelledby="conversation-h">
    <h2 id="conversation-h" class="label">conversation</h2>
    <ul class="list-plain mt-2">
      <li>conversations about ai, enterprise product, and how organizations actually change</li>
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="off-clock-h">
    <h2 id="off-clock-h" class="label">off the clock</h2>
    <ul class="list-plain links mt-2">
      <li>muay thai and jiu jitsu. still getting hit. still showing up.</li>
      <li>reading brandon sanderson, viet thanh nguyen, patty wipfler. <a href={goodreads} target="_blank" rel="noopener noreferrer">goodreads</a></li>
      <li>building small things for my kid, and the occasional toy that exists only to be strange.</li>
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="find-me-h">
    <h2 id="find-me-h" class="label">find me</h2>
    <p class="links mt-2"><a href="/contact/">email</a> · <a href="https://www.linkedin.com/in/adrianlumley/" target="_blank" rel="noopener noreferrer">linkedin</a> · <a href="https://github.com/prime3679" target="_blank" rel="noopener noreferrer">github</a></p>
  </section>
</Base>
