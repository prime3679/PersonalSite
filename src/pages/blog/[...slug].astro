---
import Redirect from '../../components/Redirect.astro';
import { getPublishedPosts, postPath } from '../../lib/content';

export async function getStaticPaths() {
  const published = await getPublishedPosts();
  return published.map((post) => ({ params: { slug: post.id }, props: { destination: postPath(post.id) } }));
}
const { destination } = Astro.props;
---
<Redirect to={destination} title="Writing | Adrian Lumley" />
