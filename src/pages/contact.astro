---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';

// Formspree redirects here after a successful submit; ?sent=1 shows the note.
const returnUrl = new URL('/contact?sent=1', Astro.site).href;

const socialLinks = [
  { label: 'linkedin', href: 'https://www.linkedin.com/in/adrianlumley/' },
  { label: 'github', href: 'https://github.com/prime3679' },
  { label: 'goodreads', href: 'https://www.goodreads.com/user/show/149439647-adrian-lumley' },
];
---

<Base title="Contact" description="get in touch with adrian lumley: product leader, builder, occasional advisor.">
  <PageIntro title="contact" standfirst="always interested in product challenges, creative projects, or just good conversation. open to advisory roles and the right side-hustle." />

  <p id="form-success" hidden class="measure mb-8" role="status">message sent, thanks for reaching out. i'll get back to you soon.</p>

  <form action="https://formspree.io/f/xjgewgoq" method="POST" class="content-stack">
    <input type="text" name="_gotcha" style="display:none" />
    <input type="hidden" name="_next" value={returnUrl} />
    <div>
      <label for="name" class="field-label">name *</label>
      <input type="text" id="name" name="name" required class="field-input" autocomplete="name" />
    </div>
    <div>
      <label for="email" class="field-label">email *</label>
      <input type="email" id="email" name="email" required class="field-input" autocomplete="email" />
    </div>
    <div>
      <label for="subject" class="field-label">subject</label>
      <input type="text" id="subject" name="subject" class="field-input" />
    </div>
    <div>
      <label for="message" class="field-label">message *</label>
      <textarea id="message" name="message" required rows="5" class="field-input"></textarea>
    </div>
    <div><button type="submit" class="button">send message</button></div>
  </form>

  <section class="mt-12" aria-labelledby="elsewhere-h">
    <h2 id="elsewhere-h" class="label">elsewhere</h2>
    <p class="links mt-2">
      {socialLinks.map((link, index) => (
        <><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>{index < socialLinks.length - 1 && ' · '}</>
      ))}
    </p>
  </section>
</Base>

<script>
  if (new URLSearchParams(location.search).has('sent')) {
    document.getElementById('form-success')?.removeAttribute('hidden');
  }
</script>
