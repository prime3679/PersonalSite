---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, postHref } from '../lib/content';
import { formatMonthYear } from '../lib/format';

// homepage: the record. one sans at body size, italic reserved for the
// section labels, and every link in the same ink with the same hairline
// underline (all of that comes from tokens.css through global.css). the
// one size jump on the page is the latest essay, which the first screen
// exists to sell. the ledger, the archive, and the lab rows share a single
// max-content label column so the whole page reads as one table.
//
// the record is the whole page: no site header, no night shift pill, no
// hamburger, no site footer (chrome={false}), and no fade-in. the ink is
// at full contrast from the first paint; the site-wide reveal animation
// used to hold this text at low opacity while the header sat fully inked
// above it, which read as light ink on light ground.

const posts = await getPublishedPosts();
const [latest, ...earlier] = posts;
const archive = earlier.slice(0, 2);

const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const displayTitle = (post: (typeof posts)[number]) => post.data.shortTitle ?? post.data.title;

const lab = [
  { title: 'Meeting cost', href: '/lab/meeting-cost/' },
  { title: 'Iron log', href: '/lab/iron-log/' },
  { title: 'Ink field', href: '/lab/ink-field/' },
];

const footerLinks = [
  { label: 'email', href: '/contact/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/adrianlumley/', external: true },
  { label: 'GitHub', href: 'https://github.com/prime3679', external: true },
  { label: 'about', href: '/about/' },
];
---

<Base
  description="Adrian Lumley is a product leader working where AI meets enterprise adoption."
  ogImage="/og/home.png"
  chrome={false}
>
  <div class="record" data-record>
    <h1 class="record__lede">Adrian Lumley is a product director in New York City.</h1>

    {latest && (
      <article class="record__feature" data-record-feature>
        <h2 class="record__feature-title"><a href={postHref(latest.id)}>{latest.data.title}</a></h2>
        <p class="record__feature-date"><time datetime={isoDate(latest.data.date)}>{formatMonthYear(latest.data.date)}</time></p>
        <p class="record__feature-dek">{latest.data.description}</p>
      </article>
    )}

    <dl class="record__ledger">
      <dt class="record__label">currently</dt>
      <dd>Salesforce.</dd>
      <dt class="record__label">past</dt>
      <dd>SiriusXM, Disney+, EA.</dd>
    </dl>

    <section class="record__section" aria-labelledby="writing-h">
      <h2 id="writing-h" class="record__label">writing</h2>
      <ul class="record__rows">
        {archive.map((post) => (
          <li class="record__row">
            <time datetime={isoDate(post.data.date)}>{formatMonthYear(post.data.date)}</time>
            <a href={postHref(post.id)}>{displayTitle(post)}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="record__section" aria-labelledby="lab-h">
      <h2 id="lab-h" class="record__label">lab</h2>
      <ul class="record__rows">
        {lab.map((item) => (
          <li class="record__row">
            <a href={item.href}>{item.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <p class="record__footer">
      {footerLinks.map((link, index) => (
        <>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >{link.label}</a>{index < footerLinks.length - 1 && ', '}
        </>
      ))}
    </p>
  </div>

  <style>
    /* the whole record is one two-column grid: labels and dates in a
       max-content column, everything else in the remainder. sections join
       it through subgrid so the column stays exactly as wide as its widest
       label plus a tight gutter, never a fractional hole. */
    .record {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: var(--s5);
      max-width: 38rem;
      color: var(--ink);
      font-family: var(--font-body);
      font-size: var(--text-body);
      font-weight: var(--weight-body);
      line-height: var(--leading-body);
      font-variant-numeric: lining-nums proportional-nums;
    }
    .record > * { grid-column: 1 / -1; margin: 0; }
    .record > * + * { margin-top: var(--s5); }
    .record__footer { margin-top: var(--s6); }

    .record h1,
    .record h2 {
      margin: 0;
      color: inherit;
      font-family: inherit;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      letter-spacing: 0;
    }

    /* the only size jump on the page */
    .record .record__feature-title {
      font-size: var(--text-feature);
      line-height: var(--leading-feature);
    }
    .record__feature-date { margin-top: var(--s1); font-style: normal; }
    .record__feature-dek { margin-top: var(--s2); max-width: 46ch; }

    /* italic is for labels only */
    .record__label { font-style: var(--label-style); }

    .record__ledger,
    .record__section,
    .record__rows,
    .record__row {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      row-gap: var(--s1);
    }
    .record__rows { margin: 0; padding: 0; list-style: none; }
    .record__section > .record__label { grid-column: 1; }
    .record__section > .record__rows { grid-column: 1 / -1; }
    .record__ledger dt { grid-column: 1; }
    .record__ledger dd { grid-column: 2; margin: 0; }
    .record__row > time { grid-column: 1; }
    .record__row > a { grid-column: 2; }

    /* every link keeps a 44px tap target without changing the row rhythm or
       the inline spacing: the padding is paid back with a matching negative
       margin on both axes, so commas still sit tight against short words. */
    .record a {
      display: inline-block;
      padding: .75rem .3rem;
      margin: -.75rem -.3rem;
    }
    .record__row > a { justify-self: start; }

    @supports not (grid-template-columns: subgrid) {
      .record__ledger,
      .record__section,
      .record__rows,
      .record__row {
        grid-template-columns: max-content minmax(0, 1fr);
      }
    }
  </style>
</Base>
