---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';

const sections = [
  { heading: 'summary', body: "JoyTap collects no personal data. No accounts, no tracking, no analytics, no ads. It's a sensory play app for toddlers, built for one family." },
  { heading: 'data collection', body: 'JoyTap does not collect, store, or transmit any personal information. The app runs entirely on your device with no network requests.' },
  { heading: 'local storage', body: "The app stores a single preference (sound on/off) using the device's local storage. This data never leaves your device and is not accessible to anyone else." },
  { heading: 'third-party services', body: 'JoyTap uses no third-party SDKs, analytics, advertising, or tracking services.' },
  { heading: "children's privacy", body: 'JoyTap is designed for use by toddlers under parental supervision. The app does not collect any information from children or anyone else.' },
];
---

<Base
  title="JoyTap Privacy Policy"
  description="Privacy policy for JoyTap, a sensory play app for toddlers."
>
  <PageIntro title="joytap privacy policy" standfirst="last updated: march 12, 2026" />

  {sections.map((section, index) => (
    <section class:list={[index > 0 && 'mt-8']}>
      <h2 class="label">{section.heading}</h2>
      <p class="measure mt-1">{section.body}</p>
    </section>
  ))}

  <section class="mt-8">
    <h2 class="label">contact</h2>
    <p class="measure links mt-1">Questions about this policy? Reach out via the <a href="/contact/">contact page</a>.</p>
  </section>
</Base>
