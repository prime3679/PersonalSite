---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { ROGUE_EPOCH } from '../data/rogue';

const rogueSince = new Date(`${ROGUE_EPOCH}T00:00:00Z`)
  .toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  .toLowerCase();
const toys = [
  { label: 'the cap is gone', href: '/lab/the-cap-is-gone/' },
  { label: 'the crazy wall', href: '/lab/crazy-wall/' },
  { label: 'fable field recorder', href: '/lab/fable-field-recorder/' },
  { label: 'iron log', href: '/lab/iron-log/' },
  { label: 'night train', href: '/lab/night-train/' },
  { label: 'joytap', href: '/writing/joytap-one-sprint/' },
  { label: 'animal garden', href: '/lab/my-kids-world/' },
  { label: 'chaos garden', href: '/lab/chaos-garden/' },
  { label: 'meeting price tag', href: '/lab/meeting-cost/' },
];
---

<Base title="Lab" description="things i'm building. not a portfolio, an honest record of what's running and what survived contact with reality.">
  <PageIntro title="lab" standfirst="things i'm building. not a portfolio, an honest record of what's running, what's in progress, and what didn't survive contact with reality." />

  <section id="rogue" aria-labelledby="rogue-h">
    <p class="label">flagship</p>
    <h2 id="rogue-h">rogue</h2>
    <div class="content-stack mt-3">
      <p>the agent i actually use. lives on a mac mini, wired to claude and codex, runs the ops i used to do by hand, and builds things, this site included. signal room is fiction about a system like it.</p>
      <p>i ran a stack of agents and kept the combination that worked.</p>
      <p>running since {rogueSince}, not as a demo but as the local system i keep using.</p>
    </div>
    <p class="links mt-4"><a href="/signal-room/">read signal room</a></p>
  </section>

  <section class="mt-12" id="past-the-pilot" aria-labelledby="past-the-pilot-h">
    <p class="label">project</p>
    <h2 id="past-the-pilot-h">past the pilot</h2>
    <p class="measure mt-3">a public evidence ledger for enterprise ai that made it into real work. 25 named systems, 74 sources, and every claim tied to a receipt.</p>
    <p class="links mt-4"><a href="https://pastthepilot.adrianlumley.co" target="_blank" rel="noopener noreferrer">open the ledger</a></p>
  </section>

  <section class="mt-12" id="fork" aria-labelledby="fork-h">
    <p class="label">toy</p>
    <h2 id="fork-h">fork</h2>
    <p class="measure mt-3">one hard decision, three futures, three marks each. fork draws them as one map, in ink and pencil, and hands the decision back. no account, no ai, nothing leaves the page.</p>
    <p class="links mt-4"><a href="/lab/fork/">open fork</a></p>
  </section>

  <section class="mt-12" id="ink-field" aria-labelledby="ink-field-h">
    <p class="label">toy</p>
    <h2 id="ink-field-h">ink field</h2>
    <p class="measure mt-3">a living sumi-e study. sumi ink pours onto warm bone paper and drifts through a seeded noise field, with rare embers of clay. tap the paper to pour, then save the print. it runs on nothing but a single html file.</p>
    <p class="links mt-4"><a href="/lab/ink-field/">open ink field</a> · <a href="https://github.com/prime3679/ink-field" target="_blank" rel="noopener noreferrer">source</a></p>
  </section>

  <section class="mt-12" id="also-built" aria-labelledby="also-built-h">
    <h2 id="also-built-h" class="label">also built</h2>
    <p class="links measure mt-2">
      {toys.map((toy, index) => (
        <>
          <a href={toy.href}>{toy.label}</a>
          {index < toys.length - 1 && ' · '}
        </>
      ))}
    </p>
  </section>
</Base>
