---
import '../../styles/essay.css';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getEpisodes, episodePath, episodeOgPath } from '../../lib/content';
import { episodeTitle, formatLongDate, padEpisode } from '../../lib/format';
import { canonicalUrl } from '../../lib/seo';

export async function getStaticPaths() {
  const episodes = await getEpisodes('asc');

  return episodes.map((episode, i) => ({
    params: { slug: episode.id },
    props: {
      episode,
      prev: i > 0 ? episodes[i - 1] : null,
      next: i < episodes.length - 1 ? episodes[i + 1] : null,
      first: episodes[0],
    },
  }));
}

interface Props {
  episode: CollectionEntry<'signal-room'>;
  prev: CollectionEntry<'signal-room'> | null;
  next: CollectionEntry<'signal-room'> | null;
  first: CollectionEntry<'signal-room'>;
}

const { episode, prev, next, first } = Astro.props;
const { Content } = await render(episode);

const pageTitle = `${episode.data.title} | Signal Room`;
const episodeLabel = (entry: CollectionEntry<'signal-room'>) => `episode ${padEpisode(entry.data.episode)}, ${entry.data.title}`;
---

<Base
  title={pageTitle}
  description={episode.data.teaser}
  ogImage={episodeOgPath(episode.id)}
  extraMainClass="essay"
  serif
  article={{
    headline: episodeTitle(episode.data.episode, episode.data.title),
    description: episode.data.teaser,
    datePublished: episode.data.date.toISOString(),
    url: canonicalUrl(Astro.url),
  }}
>
  <PageIntro title={episode.data.title} standfirst={`episode ${padEpisode(episode.data.episode)}, ${formatLongDate(episode.data.date)}`} />

  <article class="prose">
    <Content />
  </article>

  <footer class="mt-12">
    <nav aria-label="episode navigation">
      <dl class="rows">
        {prev && (
          <div class="row">
            <dt class="row__key label">previous</dt>
            <dd class="row__value"><a href={episodePath(prev.id)}>{episodeLabel(prev)}</a></dd>
          </div>
        )}
        {next && (
          <div class="row">
            <dt class="row__key label">next</dt>
            <dd class="row__value"><a href={episodePath(next.id)}>{episodeLabel(next)}</a></dd>
          </div>
        )}
        <div class="row">
          <dt class="row__key label">index</dt>
          <dd class="row__value"><a href="/signal-room/">signal room</a></dd>
        </div>
      </dl>
    </nav>
    <p class="measure links mt-6">
      signal room · a fiction serial · published on adrianlumley.co
      {episode.data.episode !== 1 && (
        <> · <a href={episodePath(first.id)}>start from episode 01</a></>
      )}
    </p>
  </footer>
</Base>
