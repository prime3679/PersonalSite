---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getEpisodes, episodePath } from '../../lib/content';
import { formatLongDate, padEpisode } from '../../lib/format';

// the serial is one table: episode number in the key column, title,
// teaser, and date in the value column. the fiction lives inside the
// episodes, not in an instrument panel above them.
const episodes = await getEpisodes('desc');
const first = episodes[episodes.length - 1];
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<Base title="Signal Room" description="short fiction about rogue, systems, households, truth, and mercy." ogImage="/og/signal-room.png">
  <PageIntro title="signal room" standfirst="short fiction about rogue and the human side of systems that try to help without becoming the weather." />

  {first && (
    <p class="measure links -mt-6 mb-12">new here? start with <a href={episodePath(first.id)}>episode {padEpisode(first.data.episode)}, {first.data.title}</a>.</p>
  )}

  <section aria-labelledby="episodes-h">
    <h2 id="episodes-h" class="label">episodes</h2>
    <ol class="rows rows--loose mt-2" reversed>
      {episodes.map((episode) => (
        <li class="row">
          <span class="row__key">{padEpisode(episode.data.episode)}</span>
          <div class="row__value">
            <h3><a href={episodePath(episode.id)}>{episode.data.title}</a></h3>
            <p>{episode.data.teaser}</p>
            <p><time datetime={isoDate(episode.data.date)}>{formatLongDate(episode.data.date)}</time></p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
