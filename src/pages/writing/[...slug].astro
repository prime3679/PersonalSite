---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { render } from 'astro:content';
import { getPublishedPosts, postHref, postPath, postOgPath } from '../../lib/content';
import { formatLongDate } from '../../lib/format';

export async function getStaticPaths() {
  const published = await getPublishedPosts();
  return published.map((post, i) => ({
    params: { slug: post.id },
    props: { post, older: published[i + 1] ?? null, newer: published[i - 1] ?? null },
  }));
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const dateFormatted = formatLongDate(post.data.date);
const updatedFormatted = post.data.updatedDate ? formatLongDate(post.data.updatedDate) : null;
const articleData = { headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), url: new URL(postPath(post.id), Astro.site).href };
const ogImagePath = postOgPath(post.id);
---

<Base title={post.data.title} description={post.data.description} article={articleData} ogImage={ogImagePath}>
  <PageIntro title={post.data.title} standfirst={updatedFormatted ? `${dateFormatted}, updated ${updatedFormatted}` : dateFormatted} />

  <article class="prose">
    <Content />
  </article>

  <footer class="mt-12">
    <nav aria-label="post navigation">
      <dl class="rows">
        {older && (
          <div class="row">
            <dt class="row__key label">older</dt>
            <dd class="row__value"><a href={postHref(older.id)}>{older.data.title}</a></dd>
          </div>
        )}
        {newer && (
          <div class="row">
            <dt class="row__key label">newer</dt>
            <dd class="row__value"><a href={postHref(newer.id)}>{newer.data.title}</a></dd>
          </div>
        )}
        <div class="row">
          <dt class="row__key label">index</dt>
          <dd class="row__value"><a href="/writing/">all writing</a></dd>
        </div>
      </dl>
    </nav>
  </footer>
</Base>
